#!/usr/bin/env node

import { createHash } from 'node:crypto';
import { spawnSync } from 'node:child_process';
import { readFileSync, realpathSync } from 'node:fs';
import { isAbsolute, join, relative, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

const root = fileURLToPath(new URL('../', import.meta.url));

function run(command, args, cwd = root) {
  const result = spawnSync(command, args, { cwd, encoding: 'utf8' });
  if (result.error) throw result.error;
  if (result.status !== 0) {
    throw new Error(`${command} failed (${result.status}): ${result.stderr.trim()}`);
  }
  return result.stdout.trim();
}

function inputPath(name) {
  if (typeof name !== 'string' || isAbsolute(name)) throw new Error('Invalid recorded input path.');
  const path = realpathSync(resolve(root, name));
  const fromRoot = relative(realpathSync(root), path);
  if (fromRoot.startsWith('..') || isAbsolute(fromRoot)) throw new Error('Input escapes the repository.');
  return path;
}

function verifyInput(name, expected) {
  const path = inputPath(name);
  const digest = createHash('sha256').update(readFileSync(path)).digest('hex');
  if (digest !== expected) throw new Error(`Recorded input digest differs: ${name}`);
  return path;
}

try {
  const args = process.argv.slice(2);
  let source;
  let check = false;
  while (args.length) {
    const arg = args.shift();
    if (arg === '--haveapi-source' && !source) source = args.shift();
    else if (arg === '--check' && !check) check = true;
    else throw new Error('Usage: tools/regenerate --haveapi-source PATH [--check]');
  }
  if (!source || source.startsWith('--')) {
    throw new Error('An explicit local --haveapi-source checkout is required.');
  }

  const pin = JSON.parse(readFileSync(join(root, 'tools/generator.json'), 'utf8'));
  const toolchain = JSON.parse(readFileSync(join(root, 'tools/toolchain.json'), 'utf8'));
  if (process.versions.node !== toolchain.node) throw new Error('Use the pinned Nix Node.js toolchain.');
  if (run('ruby', ['-e', 'print RUBY_VERSION']) !== toolchain.ruby) {
    throw new Error('Use the pinned Nix Ruby toolchain.');
  }
  if (!/^[a-f0-9]{40}$/.test(pin.haveapi_revision)) throw new Error('Invalid recorded HaveAPI revision.');
  source = realpathSync(source);
  if (realpathSync(run('git', ['rev-parse', '--show-toplevel'], source)) !== source) {
    throw new Error('--haveapi-source must identify the checkout root.');
  }
  if (run('git', ['rev-parse', 'HEAD'], source) !== pin.haveapi_revision) {
    throw new Error('HaveAPI source HEAD differs from the recorded generator revision.');
  }
  const inputs = [
    'clients/typescript', 'clients/ruby/lib/haveapi/schema.rb',
    'clients/ruby/lib/haveapi/schema', 'clients/ruby/lib/haveapi/client/version.rb', 'VERSION',
  ];
  run('git', ['diff', '--exit-code', 'HEAD', '--', ...inputs], source);
  if (run('git', ['ls-files', '--others', '--exclude-standard', '--', ...inputs], source)) {
    throw new Error('HaveAPI generator has untracked source files.');
  }
  const rubySource = [
    '-I', join(source, 'clients/ruby/lib'), '-I', join(source, 'clients/typescript/lib'),
    join(root, 'tools/generator-source.rb'),
  ];
  const identity = JSON.parse(run('ruby', [...rubySource, 'identity', source], source));
  if (identity.generator_source_sha256 !== pin.generator_source_sha256) {
    throw new Error('Generator source digest differs from the recorded identity.');
  }
  if (!pin.shared_source_identity || JSON.stringify(identity.shared_source_identity) !== JSON.stringify(pin.shared_source_identity)) {
    throw new Error('Shared Ruby-client source identity differs from the recorded identity.');
  }
  const versionDigest = createHash('sha256').update(readFileSync(join(source, 'VERSION'))).digest('hex');
  if (versionDigest !== pin.haveapi_version_sha256) throw new Error('HaveAPI VERSION digest differs.');
  for (const [name, digest] of Object.entries(pin.tooling_sha256)) verifyInput(name, digest);
  const schema = verifyInput(pin.schema_file, pin.schema_sha256);
  verifyInput(pin.provenance_file, pin.provenance_sha256);
  const snapshot = JSON.parse(readFileSync(schema, 'utf8'));
  if (snapshot.api_version !== pin.api_version) throw new Error('Recorded API version differs from schema.');
  const result = spawnSync('ruby', [
    ...rubySource, 'generate', source,
    'generate', '--schema', schema, '--api-version', pin.api_version,
    '--output', join(root, 'src/generated'), ...(check ? ['--check'] : []),
  ], { cwd: root, stdio: 'inherit' });
  if (result.error) throw result.error;
  process.exitCode = result.status ?? 1;
  if (result.status === 0) {
    const manifest = JSON.parse(readFileSync(join(root, 'src/generated/.haveapi-generated.json'), 'utf8'));
    if (manifest.generator_source_sha256 !== pin.generator_source_sha256
      || manifest.schema_sha256 !== pin.schema_sha256 || manifest.api_version !== pin.api_version) {
      throw new Error('Generated manifest differs from the recorded inputs.');
    }
  }
} catch (error) {
  console.error(`Regeneration refused: ${error.message}`);
  process.exitCode = 1;
}
