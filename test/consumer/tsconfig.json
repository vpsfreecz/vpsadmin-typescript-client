{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "paths": { "generated/*": ["../../dist/generated/*"] },
    "noEmit": true,
    "types": []
  },
  "files": ["types.ts", "modules.ts"]
}
