{
  "name": "vpsadmin-typescript-client",
  "version": "0.3.0",
  "private": false,
  "license": "MIT",
  "description": "Generated TypeScript operations for a recorded vpsAdmin API schema",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "schema/*.json",
    "schema/tooling.Gemfile.lock",
    "src/generated/.haveapi-generated.json",
    "tools/generator.json"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vpsfreecz/vpsadmin-typescript-client.git"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "typecheck:consumer": "node node_modules/typescript/bin/tsc -p test/consumer/tsconfig.json",
    "typecheck:consumer:webui": "node node_modules/typescript-webui/bin/tsc -p test/consumer/tsconfig.json --module ESNext --moduleResolution Bundler",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:package": "node tools/check-package.mjs",
    "regenerate": "node tools/regenerate",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "haveapi-client": "0.32.0"
  },
  "devDependencies": {
    "haveapi-client": "0.32.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-webui": "npm:typescript@5.9.3"
  }
}
